#!/bin/bash
#
# SAIRPi Project - Slackware AI on Raspberry Pi
# https://sairpi.penthux.net
#
# HAILO.SlackBuild [Stage 2]
#
# hailort-nnc-drv.SlackBuild
#
# This script builds and patches the NNC (neural network core) driver for
# the Hailo-10H M.2 AI Accelerator Module and creates a Slackware package.
#
