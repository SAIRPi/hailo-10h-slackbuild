#!/bin/bash
#
# SAIRPi Project - Slackware AI on Raspberry Pi
# https://sairpi.penthux.net
#
# HAILO.SlackBuild [Stage 2]
#
# rpi-kernel-source.SlackBuild
#
# This script creates a Slackware package from the Raspberry Pi Linux
# kernel source used in the HailoRT batch build process.
#
